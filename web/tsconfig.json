{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "isolatedModules": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["src", "test", "scripts", "e2e", "*.ts"]
}
