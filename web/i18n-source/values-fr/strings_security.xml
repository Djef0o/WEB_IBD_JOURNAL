    <string name="biometric_offer_title">Déverrouiller par empreinte ?</string>
    <string name="biometric_offer_text">Utilisez votre empreinte au lieu de saisir le code. Le code PIN reste valable, et il sera nécessaire si les empreintes enregistrées sur le téléphone changent.</string>
